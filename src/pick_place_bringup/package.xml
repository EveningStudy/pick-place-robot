<?xml version="1.0"?>
<package format="3">
  <name>pick_place_bringup</name>
  <version>0.1.0</version>
  <description>One-command launch orchestration for the complete pick-and-place system.</description>
  <maintainer email="eveningstudy@example.com">EveningStudy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>pick_place_description</exec_depend>
  <exec_depend>pick_place_moveit_config</exec_depend>
  <exec_depend>pick_place_perception</exec_depend>
  <exec_depend>pick_place_tasks</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
